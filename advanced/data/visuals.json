 {
  "id": "pbb-ar2025-fs-p278-v2",
  "page": 278,
  "kind": "diagram",
  "title": "Set Risk Appetite -> Cascade Risk Appetite -> Monitor Risk Appetite -> Review/Revise Risk Appetite",
  "data": {
   "steps": [
    "Set Risk Appetite",
    "Cascade Risk Appetite",
    "Monitor Risk Appetite",
    "Review/Revise Risk Appetite"
   ],
   "columns": [
    "Step 'Set Risk Appetite': Set the desired risk • appetite considering: Strategic business directions Risk taking capacity Current risk profile Articulate risk appetite • using: Risk Appetite Metrics",
    "Step 'Cascade Risk Appetite': Cascade the applicable • risk appetite via: Financial budgeting process to: Entity level Business units/ Control units level Assimilation of the • risk appetite into policies, frameworks and procedures Implementation of Key • Risk Indicators",
    "Step 'Monitor Risk Appetite': Regular monitoring of • the risk profile against the risk appetite Identify the underlying • reason for the non-achievements of the risk appetite and develop action plans to address the non-achievements",
    "Step 'Review/Revise Risk Appetite': Review/revise risk • appetite in the light of: Changing business and economic condition Evolving strategic business directions"
   ]
  }
 },
